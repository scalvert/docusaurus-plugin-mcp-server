# Copy to .env (git-ignored). Never commit real keys.

# Narration (oncue narrate).
ELEVENLABS_API_KEY=

# Media hosting (oncue deploy), if you use the default Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Experiments only: override the house voice for one run. `oncue check` fails a take made this way.
# ONCUE_VOICE_ID=
# ONCUE_MODEL_ID=
# ONCUE_VOICE_SETTINGS={"stability":0.5}
