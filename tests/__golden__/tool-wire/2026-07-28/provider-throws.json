[
  {
    "label": "tools/list",
    "status": 200,
    "contentType": "application/json",
    "body": {
      "result": {
        "tools": [
          {
            "name": "docs_search",
            "description": "Search the documentation for relevant pages. Returns matching documents ranked by relevance, with URLs, snippets, and matching sections. Use this to find information across all documentation.",
            "inputSchema": {
              "type": "object",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "A few search keywords (max 500 characters)"
                },
                "limit": {
                  "default": 16,
                  "description": "Maximum number of results to return (1-20, default: 16)",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": ["query"]
            },
            "annotations": {
              "readOnlyHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "docs_fetch",
            "description": "Fetch the complete content of a documentation page. Use this after searching to get the full markdown content of a specific page.",
            "inputSchema": {
              "type": "object",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The page to fetch: a URL from search results or a link in a fetched page (e.g., \"https://docs.example.com/docs/getting-started\" or \"/docs/getting-started\"). Add #heading-id to fetch one section"
                }
              },
              "required": ["url"]
            },
            "annotations": {
              "readOnlyHint": true,
              "openWorldHint": false
            }
          }
        ],
        "resultType": "complete",
        "ttlMs": 300000,
        "cacheScope": "public",
        "_meta": {
          "io.modelcontextprotocol/serverInfo": {
            "name": "wire-docs",
            "version": "3.1.4"
          }
        }
      },
      "jsonrpc": "2.0",
      "id": 0
    }
