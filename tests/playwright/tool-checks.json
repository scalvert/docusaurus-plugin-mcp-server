{
  "$comment": "Tool checks for docs_search and docs_fetch against the fixture docs in scripts/test-mcp-server.mjs. Each check runs as a Playwright test (tool-checks.spec.ts) on every protocol.",
  "checks": [
    {
      "id": "search-by-title",
      "description": "Title keywords find the matching page",
      "tool": "docs_search",
      "args": {
        "query": "introduction"
      },
      "isError": false,
      "containsText": ["**Introduction**", "URL: https://docs.example.com/docs/intro"]
    },
    {
      "id": "search-by-body",
      "description": "Terms that only appear in page bodies still match",
      "tool": "docs_search",
      "args": {
        "query": "OAuth"
      },
      "containsText": ["Authentication API", "https://docs.example.com/docs/api/authentication"]
    },
    {
      "id": "search-lists-numbered-results",
      "description": "Results use the numbered format and end with the fetch hint",
      "tool": "docs_search",
      "args": {
        "query": "installation"
      },
      "matchesPattern": [
        "^Found \\d+ result\\(s\\):",
        "1\\. \\*\\*[^*]+\\*\\*\\n\\s+URL: https://docs\\.example\\.com/",
        "Use docs_fetch with the URL to retrieve the full page content\\.$"
      ]
    },
    {
      "id": "search-response-shape",
      "description": "Tools answer with exactly one text content block (no structuredContent)",
      "tool": "docs_search",
      "args": {
        "query": "authentication"
      },
      "schema": "single-text-block"
    },
    {
      "id": "fetch-response-shape",
      "description": "docs_fetch also answers with one text content block",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/intro"
      },
      "schema": "single-text-block"
    },
    {
      "id": "search-respects-limit",
      "description": "limit: 1 returns exactly one result for a query several pages match",
      "tool": "docs_search",
      "args": {
        "query": "guide",
        "limit": 1
      },
      "isError": false,
      "containsText": "Found 1 result(s):"
    },
    {
      "id": "search-no-results",
      "description": "Non-matching queries return a clear message, not an error",
      "tool": "docs_search",
      "args": {
        "query": "xyznonexistent12345"
      },
      "isError": false,
      "matchesPattern": "^No matching documents found\\.$"
    },
    {
      "id": "fetch-page-structure",
      "description": "Fetched pages have a title, description, contents list, and body",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/intro"
      },
      "isError": false,
      "matchesPattern": [
        "^# Introduction\\n",
        "> Welcome to our documentation",
        "## Contents\\n\\n- \\[Introduction\\]\\(#introduction\\)\\n  - \\[Overview\\]\\(#overview\\)"
      ]
    },
    {
      "id": "fetch-page-snapshot",
      "description": "Full docs_fetch output for a page with nested headings stays stable",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/api/authentication"
      },
      "snapshot": "fetch-authentication"
    },
    {
      "id": "fetch-code-blocks",
      "description": "Code blocks survive as fenced markdown",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/installation"
      },
      "containsText": "```bash\nnpm install my-platform\n```",
      "responseSize": {
        "minBytes": 200,
        "maxBytes": 4096
      }
    },
    {
      "id": "fetch-missing-page",
      "description": "Unknown URLs return a not-found message",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/nonexistent"
      },
      "containsText": "Page not found"
    },
    {
      "id": "fetch-section-from-link",
      "description": "A link as an agent copies it (trailing slash, #fragment) resolves to just that section",
      "tool": "docs_fetch",
      "args": {
        "url": "https://docs.example.com/docs/intro/#overview"
      },
      "isError": false,
      "containsText": "> Section #overview of https://docs.example.com/docs/intro."
    },
    {
      "id": "fetch-root-relative",
      "description": "Root-relative links from fetched pages work as written",
      "tool": "docs_fetch",
      "args": {
        "url": "/docs/intro"
      },
      "isError": false,
      "matchesPattern": "^# Introduction\\n"
    },
    {
      "id": "fetch-skill",
      "description": "docs_fetch reads a skill by the skill:// URI in the server instructions (for hosts without the skills extension)",
      "tool": "docs_fetch",
      "args": {
        "url": "skill://docs-research/SKILL.md"
      },
      "isError": false,
      "matchesPattern": ["^---\\nname: docs-research\\n", "# Researching "]
    }
  ]
}
